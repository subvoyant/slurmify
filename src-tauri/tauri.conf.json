{
  "$schema": "https://schema.tauri.app/config/2",
  "productName":  "SIENA Slurmer",
  "version":      "0.2.1",
  "identifier":   "com.subvoyant.siena.slurmer",
  "build": {
    "beforeDevCommand":   "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl":             "http://localhost:1420",
    "frontendDist":       "../dist"
  },
  "app": {
    "windows": [
      {
        "title":     "SIENA Slurmer",
        "width":     1280,
        "height":    860,
        "minWidth":  980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active":     true,
    "targets":    ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements":         "entitlements.plist"
    },
    "category":   "Music",
    "shortDescription": "Slurmify your audio.",
    "longDescription":  "Subvoyant SIENA Slurmer — opinionated slurmcore: chop, time-stretch, and apply effects to audio. Local processing; your audio never leaves your machine.",
    "externalBin": [
      "binaries/slurmify-backend"
    ]
  }
}
