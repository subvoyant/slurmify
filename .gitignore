# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/

# Virtual environment
.venv/
venv/
env/

# PyInstaller build artifacts
build/
dist/
*.spec.bak

# macOS
.DS_Store
.AppleDouble
.LSOverride
# Anchored to repo root so this only matches a stray top-level Finder
# folder-icon resource-fork marker file (named "Icon\r" historically).
# Originally this line was an un-anchored `Icon?` — which on case-
# insensitive filesystems (the macOS default) silently matched any
# 5-character directory beginning with `icon`, including our
# src-tauri/icons/ folder, ghosting every icon file from every commit.
# Tauri's local Mac build still worked because tauri-bundler reads
# icons from the on-disk working tree, but CI clones got an empty
# src-tauri/icons/ and the Windows tauri-build script failed with:
# `icons/icon.ico` not found; required for generating a Windows
# Resource file during tauri-build.  Keep the leading `/` here.
/Icon?
._*
.Spotlight-V100
.Trashes

# DMG / release binaries — these are large; distribute separately
*.dmg
*.pkg
*.app

# Temp / lock files
*.tmp
~$*
.~lock.*

# Presentation source (large binary; check in if you want version history)
*.pptx
*.pdf

# Slide exports (regenerate from source)
slide-*.jpg
visuals/

# Secrets / notarization credentials (never commit these)
*.p8
*.p12
notarize_creds.sh
.env

# Editor
.vscode/
.idea/
*.swp

# Graphics source — mostly large binaries (stock footage packs, AE/PSD
# sources, ~5 GB total).  Ignored by default to keep the repo lean.
# A handful of small files inside graphic/ are RUNTIME assets the React
# app actually imports (easter-egg GIFs); those need to ship to CI and
# end users via the bundled frontend.  Allow them back through with
# explicit !-rules.  Pattern is `graphic/*` not `graphic/` because git
# never descends into a fully-ignored directory, so negation only works
# when the directory itself isn't ignored.
graphic/*
!graphic/.gitkeep
!graphic/MaxFire02.gif
!graphic/max.gif
!graphic/hobermanmax.gif
!graphic/RGBOB.gif
# graphic/sienaSlrum_A001.aep is already tracked (pre-dates this rule);
# don't need an explicit !-line for it.

DMG_builds/

# ── Tauri 2 + React frontend (v0.2.0, ADR-0022) ────────────────────────
# Node / pnpm
node_modules/
.pnpm-store/
pnpm-debug.log*

# Vite build output (the dist/ entry above already covers this for the
# Python side; explicit here for clarity since the meaning is different)
# dist/        # already covered by the Python section

# Tauri / Rust artifacts
src-tauri/target/
src-tauri/gen/
.cargo/
# Cargo.lock IS tracked — Tauri docs recommend it for apps (deterministic
# builds across machines).  See https://doc.rust-lang.org/cargo/faq.html#why-have-cargolock-in-version-control

# Bundled sidecar binary — produced by scripts/build-sidecar.sh from
# src-python/.  ~100 MB onefile PyInstaller bundle; rebuilt on every
# release.  Don't track.
src-tauri/binaries/

# TypeScript incremental-build cache files (regenerated by tsc)
*.tsbuildinfo

# Local backend discovery file (server.py writes /tmp/slurmify-backend.json)
.slurmify-backend.json
slurmify-backend.json

# Dev-only commit message scratch files
.commit_v*_msg.txt

